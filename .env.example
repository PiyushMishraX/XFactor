# X FACTOR — environment template (repository root)
#
# The FastAPI backend is the only process that reads these variables today.
# The canonical, service-scoped template is `backend/.env.example`.
#
# Copy to `.env` in the directory you run the backend from and fill in real
# values. NEVER commit the real `.env` file or hard-code secrets in source.

# --- Application -------------------------------------------------------
APP_NAME="X FACTOR"
APP_VERSION="0.1.0"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
API_PREFIX=/api
# Comma separated list of origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL --------------------------------------------------------
# Optional: paste a full connection URI here and it overrides the parts
# below (this is what managed providers hand out). Example:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=xfactor
POSTGRES_PASSWORD=
POSTGRES_DB=xfactor
DB_CONNECT_TIMEOUT=3

# --- Google Gemini (LLM reasoning) — used from Step 1 onwards ----------
GEMINI_API_KEY=
# gemini-1.5/2.5 models are retired for new keys and return 404.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# --- LangGraph orchestration — used from Step 4 onwards -----------------
LANGGRAPH_MAX_ITERATIONS=6
LANGGRAPH_CHECKPOINT_BACKEND=postgres

# --- SAP integration — used from Step 7 onwards -------------------------
SAP_BASE_URL=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
# When true the system uses a clearly labelled mock SAP adapter instead of
# a live SAP tenant.
SAP_USE_MOCK=true
