# X FACTOR — frontend environment template
#
# Copy this file to `frontend/.env` to override local defaults.
# Only VITE_-prefixed variables are exposed to the browser.
# NEVER put secrets (API keys, credentials) in frontend variables.

# Base URL of the X FACTOR backend API.
# Leave as "/api" to use the Vite dev-server proxy (see vite.config.js).
VITE_API_BASE_URL=/api
