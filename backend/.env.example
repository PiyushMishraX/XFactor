# X FACTOR — backend environment template
#
# Copy this file to `backend/.env` and fill in real values.
# NEVER commit the real `.env` file. Never put secret values in source code.

# --- Application -------------------------------------------------------
APP_NAME="X FACTOR"
APP_VERSION="0.1.0"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
API_PREFIX=/api
# Comma separated list of origins allowed to call the API (CORS).
# Local dev:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production (Cloudflare Pages):
# CORS_ORIGINS=https://your-project.pages.dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL --------------------------------------------------------
# Optional: paste a full connection URI here and it overrides the parts
# below (this is what managed providers hand out). Example:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=xfactor
POSTGRES_PASSWORD=
POSTGRES_DB=xfactor
DB_CONNECT_TIMEOUT=3

# --- Google Gemini (LLM reasoning) — used from Step 1 onwards ----------
GEMINI_API_KEY=
# gemini-1.5/2.5 models are retired for new keys and return 404.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_OUTPUT_TOKENS=2048
# Additional keys, comma-separated. The effective list is GEMINI_API_KEY first,
# then these, with duplicates removed.
GEMINI_API_KEYS=
# Optional explicit per-agent slots (agents not listed are round-robin):
# disruption_sensing, scenario_planning, rerouting_logistics,
# inventory_rebalancing, compliance_audit
GEMINI_KEY_SLOTS=
# Minimum seconds between requests sharing one key; raise it to stay under
# per-minute limits. Retry attempt N waits N × GEMINI_RETRY_BACKOFF_SECONDS.
GEMINI_MIN_INTERVAL_SECONDS=6
GEMINI_RETRY_BACKOFF_SECONDS=5
# Longest Google-reported quota retry delay (seconds) that is waited for in
# process. Daily quotas report hours, so their key is quarantined and the call
# rotates to the next configured key instead.
GEMINI_QUOTA_RETRY_MAX_SECONDS=120
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# --- LangGraph orchestration — used from Step 4 onwards -----------------
LANGGRAPH_MAX_ITERATIONS=6
LANGGRAPH_CHECKPOINT_BACKEND=postgres

# --- Human approval — used from Step 6 onwards --------------------------
# Comma-separated "token:approver_id:Role" entries; Role is Manager, Director
# or Admin. The approval API returns 503 until this is set. NEVER commit real
# tokens.
APPROVER_CREDENTIALS=

# --- Authorized execution — used from Step 6 onwards --------------------
# While true (the default) a clearly labelled [SIMULATED] execution adapter is
# used and no operational system is changed. Set to false only with a gateway.
EXECUTION_USE_MOCK=true
EXECUTION_BASE_URL=
EXECUTION_CLIENT_ID=
EXECUTION_CLIENT_SECRET=
EXECUTION_TIMEOUT_SECONDS=15
EXECUTION_MAX_ATTEMPTS=3

# --- SAP integration — used from Step 7 onwards -------------------------
# Prepared profile: s4hana | business_accelerator_hub | btp | integration_suite
SAP_API_FAMILY=s4hana
SAP_BASE_URL=
# OAuth2 client-credentials token endpoint. When set, SAP requests carry a
# bearer token; otherwise the gateway x-api-key convention is used.
SAP_AUTH_URL=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
# Read and write request different scopes so a read token cannot write.
SAP_READ_SCOPE=sap.read
SAP_WRITE_SCOPE=sap.write
# Write access is a separate permission and is disabled by default.
SAP_WRITE_ENABLED=false
# When true the system uses a clearly labelled mock SAP adapter instead of
# a live SAP tenant. No live SAP tenant is contacted in this project.
SAP_USE_MOCK=true
